{
  "name": "english-class-booking",
  "version": "3.3.0",
  "description": "English Class Booking v3 - multi-teacher class board, notice board, Google Maps address bar, real timezones, online & offline classes, live bookings (4-language i18n)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/test-suite.js",
    "test:e2e": "node tests/e2e-full.js",
    "test:ui": "node scripts/ui-smoke.js",
    "test:visual": "node scripts/visual-audit.js",
    "user": "node scripts/create-user.js",
    "reset:data": "node scripts/reset-data.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check": "node scripts/check-i18n.js && node --check server.js && npm test",
    "admin": "node scripts/grant-admin.js",
    "test:admin": "node tests/superadmin-suite.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "google-auth-library": "^10.6.1",
    "sql.js": "^1.10.3"
  }
}
